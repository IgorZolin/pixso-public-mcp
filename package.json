{
  "name": "pixso-public-mcp",
  "version": "0.2.2",
  "description": "Unofficial read-only MCP server that decodes PUBLIC Pixso design files for AI coding agents. No login, no seat, no dependencies.",
  "type": "module",
  "bin": {
    "pixso-public-mcp": "pixso-mcp.mjs"
  },
  "scripts": {
    "schema": "node scripts/get-schema.mjs",
    "postinstall": "node scripts/get-schema.mjs || true"
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "pixso-mcp.mjs",
    "pixso-kiwi.mjs",
    "pixso-svg.mjs",
    "kiwi-schema.mjs",
    "pixso-fetch.mjs",
    "pixso-har.mjs",
    "scripts/get-schema.mjs",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": ["mcp", "pixso", "design-to-code", "kiwi", "model-context-protocol"],
  "license": "MIT"
}
