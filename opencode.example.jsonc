// Example OpenCode MCP config for pixso-public-mcp.
// Copy the "pixso" block into your opencode.json / opencode.jsonc (project root
// or ~/.config/opencode/opencode.json), and set the absolute path to pixso-mcp.mjs.
//
// For the PUBLIC Pixso cloud (pixso.net): delete the whole "environment" block —
// the defaults already point at api.pixso.net.
//
// For a self-hosted / corporate Pixso: links to your host already work (API/WS are
// taken from the link). Keep "environment" only if the API lives on another host;
// replace "pixso-url" with it. (Anonymous/public access to the file is still required.)
// "command" must use Node >= 22.15 — give the full path if the system node is older.
//
// "timeout" is bumped because the first call opens a websocket and waits for the
// whole document (big files: tens of seconds) — OpenCode's default MCP timeout is
// 5000 ms, which is too short. Later calls on the same file hit a 5-minute cache.
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pixso": {
      "type": "local",
      "command": ["node", "/abs/path/to/pixso-public-mcp/pixso-mcp.mjs"],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "PIXSO_API": "https://pixso-url",
        "PIXSO_WS": "wss://pixso-url",
        "PIXSO_SCHEMA_URL": "https://pixso-url/app/pixso.binary"
      }
    }
  }
}
